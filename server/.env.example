NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jobpilot

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Single-user v1: registration is open only while no user exists.
# Set to true later when the app goes public.
ALLOW_REGISTRATION=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Ollama (Phase 2)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# LibreOffice for PDF export (defaults: Windows install path / "soffice" on Linux)
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Serve the built dashboard from this server (run: cd ../web && npm run build)
# WEB_DIST=../web/dist
